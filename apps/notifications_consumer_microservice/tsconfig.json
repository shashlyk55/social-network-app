{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],

    // Строгие проверки (рекомендуется NestJS)
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,

    // Декораторы
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Модули
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Пути
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },

    // Вывод
    "outDir": "./dist",
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,

    // Оптимизации
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Совместимость
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src/**/*", "test/**/*", "db"],
  "exclude": ["node_modules", "dist"]
}
